{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/commerce/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/house/**",
              "components/navigation/**",
              "ui_kits/admin/**",
              "ui_kits/storefront/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cairo|Material Symbols Outlined))/i]",
        "message": "Font not provided by the design system. Available: Cairo, Material Symbols Outlined."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<AdminNavItem> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|icon|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, size, icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|navy|neutral|wholesale|success|danger|count)$/]",
        "message": "<Badge> tone must be one of 'brand' | 'navy' | 'neutral' | 'wholesale' | 'success' | 'danger' | 'count'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Crumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<Crumb> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconAfter|fullWidth|disabled|as|href|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconAfter, fullWidth, disabled, as, href, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|navy|secondary|ghost|wholesale|success)$/]",
        "message": "<Button> variant must be one of 'primary' | 'navy' | 'secondary' | 'ghost' | 'wholesale' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:padding|radius|hoverable|as|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: padding, radius, hoverable, as, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Card> radius must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CartLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|details|image|price|quantity|stale|onQuantity|onRemove|style|key|ref|className|style|children)$/]",
        "message": "<CartLine> doesn't accept that prop. Declared props: name, details, image, price, quantity, stale, onQuantity, onRemove, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tone|title|description|actionLabel|actionIcon|onAction|href|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, tone, title, description, actionLabel, actionIcon, onAction, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|danger|wholesale)$/]",
        "message": "<EmptyState> tone must be one of 'neutral' | 'danger' | 'wholesale'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HouseSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:slug|name|icon|key|ref|className|style|children)$/]",
        "message": "<HouseSection> doesn't accept that prop. Declared props: slug, name, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|fill|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, fill, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tone|size|badge|label|as|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, tone, size, badge, label, as, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:on-navy|on-light|danger)$/]",
        "message": "<IconButton> tone must be one of 'on-navy' | 'on-light' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<IconButton> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|type|placeholder|value|onChange|error|name|required|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, type, placeholder, value, onChange, error, name, required, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|icon|title|description|actionLabel|onClose|style|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, icon, title, description, actionLabel, onClose, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrderSummary'] > JSXAttribute > JSXIdentifier[name!=/^(?:subtotal|onSend|onCopy|disabled|style|key|ref|className|style|children)$/]",
        "message": "<OrderSummary> doesn't accept that prop. Declared props: subtotal, onSend, onCopy, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|wholesale|startingFrom|size|label|style|key|ref|className|style|children)$/]",
        "message": "<PriceTag> doesn't accept that prop. Declared props: value, wholesale, startingFrom, size, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceTag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<PriceTag> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|description|image|price|wholesale|startingFrom|inStock|onAdd|onOpen|href|style|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: name, description, image, price, wholesale, startingFrom, inStock, onAdd, onOpen, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuantityStepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<QuantityStepper> doesn't accept that prop. Declared props: value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoomLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|icon|gift|open|delay|bounds|iconBase|onClick|style|key|ref|className|style|children)$/]",
        "message": "<RoomLabel> doesn't accept that prop. Declared props: name, icon, gift, open, delay, bounds, iconBase, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchHit'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|image|section|price|key|ref|className|style|children)$/]",
        "message": "<SearchHit> doesn't accept that prop. Declared props: id, name, image, section, price."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:slug|name|icon|key|ref|className|style|children)$/]",
        "message": "<NavSection> doesn't accept that prop. Declared props: slug, name, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|radius|style|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: width, height, radius, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|value|tone|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: icon, label, value, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|navy)$/]",
        "message": "<StatCard> tone must be one of 'brand' | 'navy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoreFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|maxWidth|style|key|ref|className|style|children)$/]",
        "message": "<StoreFooter> doesn't accept that prop. Declared props: links, maxWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoreHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:cartCount|children|onCart|onHome|style|key|ref|className|style|children)$/]",
        "message": "<StoreHeader> doesn't accept that prop. Declared props: cartCount, children, onCart, onHome, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwatchOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|inStock|key|ref|className|style|children)$/]",
        "message": "<SwatchOption> doesn't accept that prop. Declared props: value, label, inStock."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
